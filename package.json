{
  "name": "pwa-kit",
  "version": "0.1.0",
  "description": "What every installed web app shows about itself, for React PWAs: @pwa-kit/whats-new (the Update ready summary, a one-time What's new sheet after an update, the versions list for About, a Check for updates button and the version link to CHANGELOG.md on GitHub, a React package) and @pwa-kit/tips (a list of one-time tips, which one to show now, dismissed for good through an injected storage).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonathan-A-White/pwa-kit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    "./whats-new": {
      "types": "./packages/whats-new/dist/index.d.ts",
      "default": "./packages/whats-new/dist/index.js"
    },
    "./whats-new/styles.css": "./packages/whats-new/dist/styles.css",
    "./tips": {
      "types": "./packages/tips/dist/index.d.ts",
      "default": "./packages/tips/dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "packages/*/dist/**",
    "packages/*/package.json",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b packages/whats-new/tsconfig.build.json packages/tips/tsconfig.build.json && node -e \"require('node:fs').copyFileSync('packages/whats-new/src/styles.css', 'packages/whats-new/dist/styles.css')\"",
    "prepare": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/whats-new/tsconfig.json --noEmit",
    "test": "npm run check:personal && vitest run",
    "check:personal": "node scripts/check-personal.mjs",
    "smoke": "node scripts/consumer-smoke.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.1",
    "jsdom": "^28.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.18"
  }
}
