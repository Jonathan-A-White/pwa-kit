{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "pwa-kit/tips": ["packages/tips/src/index.ts"],
      "pwa-kit/day/eslint": ["packages/day/src/eslint.ts"],
      "pwa-kit/day": ["packages/day/src/index.ts"],
      "pwa-kit/test-preset": ["packages/test-preset/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/tests", "vitest.config.ts", "eslint.config.js"],
  "exclude": ["packages/whats-new", "packages/alive", "packages/tap", "**/dist"]
}
